{
  "platform": "tiktok",
  "enabled": true,
  "env_prefix": "TIKTOK_MAIN",
  "post_mode": "inbox",
  "privacy_level": "SELF_ONLY",
  "disable_comment": false,
  "disable_duet": false,
  "disable_stitch": false,
  "metadata_rules": {
    "hashtag_count": 3,
    "youtube_tag_count": 0
  },
  "schedule_slots": [
    {
      "id": "tkmain_matin",
      "window": {
        "start": "08:00",
        "end": "10:00"
      },
      "animation_strategy": "random",
      "exclude_animations": [
        "fb_duel"
      ]
    },
    {
      "id": "tkmain_fin_matinee",
      "window": {
        "start": "10:30",
        "end": "12:00"
      },
      "animation_strategy": "random",
      "exclude_animations": [
        "fb_duel"
      ]
    },
    {
      "id": "tkmain_match_du_jour",
      "window": {
        "start": "12:30",
        "end": "14:30"
      },
      "animation_strategy": "fixed",
      "target_animation": "fb_duel",
      "max_matches": 2,
      "publish_before_kickoff_min": 180
    },
    {
      "id": "tkmain_soir",
      "window": {
        "start": "16:00",
        "end": "18:00"
      },
      "animation_strategy": "random",
      "exclude_animations": [
        "fb_duel"
      ]
    }
  ],
  "timezone": "Europe/Paris"
}
