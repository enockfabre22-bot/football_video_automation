{
  "platform": "youtube",
  "enabled": true,
  "privacy_status": "public",
  "metadata_rules": {
    "hashtag_count": 4,
    "youtube_tag_count": 15
  },
  "schedule_slots": [
    {
      "id": "avantfoot_matin",
      "window": {
        "start": "09:00",
        "end": "10:00"
      },
      "animation_strategy": "random",
      "exclude_animations": [
        "fb_duel"
      ]
    },
    {
      "id": "avantfoot_midi",
      "window": {
        "start": "12:30",
        "end": "13:30"
      },
      "animation_strategy": "random",
      "exclude_animations": [
        "fb_duel"
      ]
    },
    {
      "id": "avantfoot_match_du_jour",
      "window": {
        "start": "17:30",
        "end": "18:30"
      },
      "animation_strategy": "fixed",
      "target_animation": "fb_duel",
      "max_matches": 1,
      "publish_before_kickoff_min": 180
    },
    {
      "id": "avantfoot_quiz_dimanche",
      "window": {
        "start": "16:00",
        "end": "16:30"
      },
      "animation_strategy": "fixed",
      "target_animation": "quiz_guess_player",
      "days": [
        "sun"
      ]
    }
  ],
  "timezone": "Europe/Paris"
}
