{
  "name": "midi_falling_short",
  "enabled": true,
  "accounts": ["youtube_piano"],
  "requires_match_data": false,
  "inputs": ["midi2", "jpg_portrait"],
  "min_free_disk_gb": 3,
  "metadata": {
    "titles": [
      "{midi} 🎹 Piano Cover",
      "{midi} | Piano",
      "{midi} (Piano Version) 🎹"
    ],
    "descriptions": [""],
    "hashtags": ["#piano", "#pianocover", "#pianotutorial", "#synthesia", "#pianomusic", "#satisfying"],
    "youtube_tags": [
      "piano", "piano cover", "{midi}", "piano tutorial", "synthesia", "piano music", "easy piano", "pianosolo"
    ]
  },
  "thumbnail": {
    "enabled": false
  },
  "steps": [
    {
      "type": "python",
      "name": "Préparation piano (extrait, interprétation, son Salamander)",
      "script": "engines/piano/prepare.py",
      "args": ["--format", "portrait", "--max-seconds", "58", "--names", "artist_title"]
    },
    {
      "type": "sandbox",
      "name": "Rendu raylib des notes",
      "profile": "raylib_box2d",
      "source": "../../engines/piano/scene",
      "seed": "random",
      "video_from": "piano/video.json"
    },
    {
      "type": "python",
      "name": "Assemblage vidéo + piano",
      "script": "engines/piano/finalize.py",
      "args": ["--thumbnail"]
    }
  ]
}
