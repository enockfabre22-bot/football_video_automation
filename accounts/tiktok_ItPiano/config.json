{
  "platform": "tiktok",
  "enabled": true,
  "env_prefix": "tiktok_ItPiano",
  "post_mode": "inbox",
  "privacy_level": "SELF_ONLY",
  "disable_comment": false,
  "disable_duet": false,
  "disable_stitch": false,
  "metadata_rules": {
    "hashtag_count": 4,
    "youtube_tag_count": 0
  },
  "schedule_slots": [
    {
      "id": "tiktok_ItPiano_matin",
      "window": {"start": "08:00", "end": "10:00"},
      "animation_strategy": "fixed",
      "target_animation": "midi_falling"
    },
    {
      "id": "tiktok_ItPiano_apresmidi",
      "window": {"start": "13:00", "end": "16:00"},
      "animation_strategy": "fixed",
      "target_animation": "midi_falling"
    }
  ],
  "timezone": "Europe/Paris"
}
