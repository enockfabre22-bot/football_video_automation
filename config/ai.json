{
  "enabled": true,

  "models": {
    "design": "claude-sonnet-5-5",
    "code": "claude-sonnet-5-5",
    "visual_review": "claude-sonnet-5-5",
    "history_card": "claude-haiku-5-5",
    "escalation": null
  },

  "effort": { "concept": "medium", "code": "medium", "fix": "medium", "review": "medium", "card": "low" },
  "max_tokens": { "concept": 16000, "code": 100000, "fix": 64000, "review": 32000, "card": 4000 },

  "pricing_usd_per_mtok": {
    "claude-sonnet-5-5": { "input": 2.00, "output": 10.00, "cache_read": 0.10, "cache_write_1h": 4.00 },
    "claude-haiku-5-5": { "input": 0.10, "output": 0.50, "cache_read": 0.01, "cache_write_1h": 0.20 },
    "claude-opus-5-5": { "input": 4.00, "output": 20.00, "cache_read": 0.20, "cache_write_1h": 8.00 }
  },

  "budgets_usd": {
    "per_creation": 2.50,
    "per_animation_monthly": 60.00,
    "global_monthly": 150.00
  },

  "limits": {
    "max_concept_attempts": 2,
    "max_code_fixes": 3,
    "max_visual_reviews": 3,
    "review_accept_score": 6,
    "max_final_renders": 1,
