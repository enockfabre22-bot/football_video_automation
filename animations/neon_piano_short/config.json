{
  "name": "neon_piano_short",
  "enabled": true,
  "accounts": [
    "youtube_piano"
  ],
  "requires_match_data": false,
  "inputs": [
    "midi2",
    "jpg_portrait"
  ],
  "min_free_disk_gb": 3,
  "metadata": {
    "titles": [
      "{midi} 🎹 Piano Cover",
      "{midi} | Piano",
      "{midi} (Piano Version) 🎹"
    ],
    "descriptions": [
      ""
    ],
    "hashtags": [
      "#piano",
      "#pianocover",
      "#pianotutorial",
      "#synthesia",
      "#pianomusic",
      "#satisfying"
    ],
    "youtube_tags": [
      "piano",
      "piano cover",
      "{midi}",
      "piano tutorial",
      "synthesia",
      "piano music",
      "easy piano",
      "pianosolo"
    ]
  },
  "thumbnail": {
    "enabled": false
  },
  "steps": [
    {
      "type": "python",
      "name": "Préparation (style néon : extrait, tonalité, Salamander, pédale)",
      "script": "engines/piano/prepare.py",
      "args": [
        "--format",
        "portrait",
        "--max-seconds",
        "30",
        "--names",
        "artist_title",
        "--style",
        "neon"
      ]
    },
    {
      "type": "sandbox",
      "name": "Rendu raylib (Falling Notes néon)",
      "profile": "raylib_box2d",
      "source": "../../engines/piano/scene",
      "seed": "random",
      "video_from": "piano/video.json"
    },
    {
      "type": "python",
      "name": "Assemblage vidéo + piano + miniature",
      "script": "engines/piano/finalize.py",
      "args": [
        "--thumbnail"
      ]
    }
  ]
}
