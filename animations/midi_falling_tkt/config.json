{
  "name": "midi_falling_tkt",
  "enabled": true,
  "accounts": ["tiktok_ItPiano"],
  "requires_match_data": false,
  "inputs": ["midi2", "jpg_portrait"],
  "min_free_disk_gb": 3,
  "metadata": {
    "titles": [
      "{midi} 🎹",
      "{midi} on piano 🎹",
      "{midi} | Piano Cover"
    ],
    "descriptions": [""],
    "hashtags": ["#piano", "#pianocover", "#pianotutorial", "#synthesia", "#pianomusic", "#satisfying", "#fyp"],
    "youtube_tags": []
  },
  "thumbnail": {
    "enabled": false
  },
  "steps": [
    {
      "type": "python",
      "name": "Préparation piano (extrait, interprétation, son Salamander)",
      "script": "engines/piano/prepare.py",
      "args": ["--format", "portrait", "--max-seconds", "65", "--names", "artist_title"]
    },
    {
      "type": "sandbox",
      "name": "Rendu raylib des notes",
      "profile": "raylib_box2d",
      "source": "../../engines/piano/scene",
      "seed": "random",
      "video_from": "piano/video.json"
    },
    {
      "type": "python",
      "name": "Assemblage vidéo + piano",
      "script": "engines/piano/finalize.py",
      "args": ["--thumbnail"]
    }
  ]
}
