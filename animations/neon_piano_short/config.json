{
  "name": "neon_piano_short",
  "enabled": true,
  "accounts": [
    "youtube_piano"
  ],
  "requires_match_data": false,
  "inputs": [
    "library",
    "jpg_portrait"
  ],
  "min_free_disk_gb": 3,
  "metadata": {
    "titles": [
      "{title} - {artist} | Piano Cover 🎹",
      "{title} - {artist} | {easy}Piano Tutorial 🎹",
      "{title} ({artist}) on Piano 🎹",
      "How to Play {title} on Piano - {artist} 🎹"
    ],
    "descriptions": [
      "{title} by {artist} — {easy}piano tutorial with falling notes 🎹\nLearn how to play {title} on piano: follow the notes as they fall onto the keys.\n\n🔔 Subscribe for a new piano cover every day!",
      "🎹 {title} - {artist} | Piano Cover\nA piano version of {title} by {artist}, with every note falling onto the keyboard (Synthesia style).\n\n🔔 Subscribe for piano covers of your favourite songs!"
    ],
    "hashtags": [
      "#{artist_tag}",
      "#piano",
      "#pianocover",
      "#pianotutorial",
      "#shorts",
      "#synthesia",
      "#pianomusic"
    ],
    "youtube_tags": [
      "{title}",
      "{artist}",
      "{title} {artist}",
      "{title} piano",
      "{title} piano tutorial",
      "{title} piano cover",
      "{artist} piano",
      "how to play {title} on piano",
      "{title} {easy}piano",
      "piano",
      "piano cover",
      "piano tutorial",
      "easy piano",
      "piano music",
      "synthesia",
      "falling notes",
      "piano shorts",
      "piano song",
      "relaxing piano"
    ]
  },
  "thumbnail": {
    "enabled": false
  },
  "steps": [
    {
      "type": "python",
      "name": "Préparation (style néon : extrait, tonalité, Salamander, pédale)",
      "script": "engines/piano/prepare.py",
      "args": [
        "--format",
        "portrait",
        "--max-seconds",
        "30",
        "--names",
        "artist_title",
        "--style",
        "neon"
      ]
    },
    {
      "type": "sandbox",
      "name": "Rendu raylib (Falling Notes néon)",
      "profile": "raylib_box2d",
      "source": "../../engines/piano/scene",
      "seed": "random",
      "video_from": "piano/video.json"
    },
    {
      "type": "python",
      "name": "Assemblage vidéo + piano + miniature",
      "script": "engines/piano/finalize.py",
      "args": [
        "--thumbnail"
      ]
    }
  ],
  "library": {
    "repeat_days": 45
  }
}