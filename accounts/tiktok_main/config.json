{
  "platform": "tiktok",
  "enabled": true,
  "env_prefix": "TIKTOK_MAIN",
  "post_mode": "inbox",
  "privacy_level": "SELF_ONLY",
  "disable_comment": false,
  "disable_duet": false,
  "disable_stitch": false,
  "metadata_rules": {
    "hashtag_count": 3,
    "youtube_tag_count": 0
  },
  "schedule_slots": [
    {
      "id": "matin_01",
      "window": {"start": "07:00", "end": "09:00"},
      "animation_strategy": "fixed",
      "target_animation": "animation_01"
    },
    {
      "id": "matin_0",
      "window": {"start": "09:00", "end": "10:30"},
      "animation_strategy": "fixed",
      "target_animation": "animation_01"
    },
    {
      "id": "midi",
      "window": {"start": "11:00", "end": "13:00"},
      "animation_strategy": "fixed",
      "target_animation": "animation_01"
    },
    
    
    {
      "id": "soir_aleatoire",
      "window": {"start": "17:00", "end": "18:00"},
      "animation_strategy": "random",
      "exclude_animations": ["animation_02"]
    }
  ],
  "timezone": "Europe/Paris"
}