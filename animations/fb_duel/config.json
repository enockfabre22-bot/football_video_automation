{
  "name": "fb_duel",
  "enabled": true,
  "accounts": [
    "youtube_avantfoot",
    "tiktok_main"
  ],
  "requires_match_data": true,
  "inputs": [
    "home_logo",
    "away_logo"
  ],
  "min_free_disk_gb": 3,
  "metadata": {
    "titles": [
      "{home} vs {away}: we simulated the match ⚽ Final score?",
      "{home} vs {away} prediction 🔮 Simulated before kick-off",
      "{home} vs {away} ⚽ Who wins tonight?",
      "We simulated {home} vs {away}... what's your score? 👇",
      "{home} vs {away}: the full match in 30 seconds ⚽"
    ],
    "descriptions": [
      "{home} vs {away}: we simulated the whole match before kick-off, 90 minutes in 30 seconds. Goals, saves, a late twist... Is this how it ends for real? Drop your score prediction 👇\n\n🔔 Subscribe: every big match simulated before kick-off!"
    ],
    "hashtags": [
      "#{home}",
      "#{away}",
      "#{competition_tag}",
      "#football",
      "#soccer",
      "#footballshorts",
      "#prediction"
    ],
    "youtube_tags": [
      "{home} vs {away}",
      "{home}",
      "{away}",
      "{home} vs {away} prediction",
      "{competition}",
      "{home} {away}",
      "match prediction",
      "score prediction",
      "football",
      "soccer",
      "football simulation",
      "match simulation",
      "simulation",
      "football shorts",
      "who will win",
      "football prediction"
    ]
  },
  "thumbnail": {
    "enabled": false
  },
  "steps": [
    {
      "type": "python",
      "name": "Préparation (big match : équipes, écussons, fond, textes)",
      "script": "engines/football/prepare.py",
      "args": [
        "--format",
        "bigmatch"
      ]
    },
    {
      "type": "sandbox",
      "name": "Rendu raylib (moteur foot)",
      "profile": "raylib_box2d",
      "source": "../../engines/football/scene",
      "sounds_dir": "../../assets/sounds/football",
      "seed": "random",
      "video_from": "football/video.json"
    },
    {
      "type": "python",
      "name": "Ambiance de stade, mixage -14 LUFS, miniature",
      "script": "engines/football/finalize.py"
    }
  ]
}
