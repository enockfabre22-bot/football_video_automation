{
  "name": "neon_piano",
  "enabled": true,
  "accounts": [
    "youtube_piano"
  ],
  "requires_match_data": false,
  "inputs": [
    "midi2",
    "jpg"
  ],
  "min_free_disk_gb": 3,
  "metadata": {
    "titles": [
      "{title} - {artist} | Piano Tutorial (Full Song) 🎹",
      "{title} - {artist} | {easy}Piano Cover (Full Version)",
      "{title} ({artist}) - {easy}Piano Tutorial | Full Song"
    ],
    "descriptions": [
      "🎹 {title} - {artist} | {easy}Piano Tutorial (Full Song)\n\nLearn how to play {title} by {artist} on piano with this falling notes tutorial (Synthesia style). Follow the notes as they fall onto the keys: every key lights up when it is played.\n\n🎵 Song: {title}\n🎤 Artist: {artist}\n🎹 Piano cover / piano tutorial, full song\n\n🔔 Subscribe for a new full piano tutorial every day!",
      "{title} by {artist} — full piano cover with falling notes 🎹\n\nA complete piano version of {title} ({artist}). Perfect to learn the song, practice, or simply relax with beautiful piano music.\n\n🔔 Subscribe and turn on notifications for more piano covers!"
    ],
    "hashtags": [
      "#{artist_tag}",
      "#piano",
      "#pianotutorial",
      "#pianocover",
      "#synthesia",
      "#pianomusic"
    ],
    "youtube_tags": [
      "{title}",
      "{artist}",
      "{title} {artist}",
      "{title} piano",
      "{title} piano tutorial",
      "{title} piano cover",
      "{artist} piano",
      "how to play {title} on piano",
      "{title} {easy}piano",
      "{title} full song piano",
      "piano",
      "piano tutorial",
      "piano cover",
      "easy piano",
      "piano music",
      "synthesia",
      "falling notes",
      "full song",
      "learn piano"
    ]
  },
  "thumbnail": {
    "enabled": false
  },
  "steps": [
    {
      "type": "python",
      "name": "Préparation (style néon : extrait, tonalité, Salamander, pédale)",
      "script": "engines/piano/prepare.py",
      "args": [
        "--format",
        "landscape",
        "--excerpt",
        "full",
        "--max-seconds",
        "300",
        "--names",
        "artist_title",
        "--style",
        "neon"
      ]
    },
    {
      "type": "sandbox",
      "name": "Rendu raylib (Falling Notes néon)",
      "profile": "raylib_box2d",
      "source": "../../engines/piano/scene",
      "seed": "random",
      "video_from": "piano/video.json"
    },
    {
      "type": "python",
      "name": "Assemblage vidéo + piano + miniature",
      "script": "engines/piano/finalize.py",
      "args": [
        "--thumbnail"
      ]
    }
  ]
}