{
  "platform": "youtube",
  "enabled": true,
  "privacy_status": "public",
  "metadata_rules": {
    "hashtag_count": 4,
    "youtube_tag_count": 15
  },
  "schedule_slots": [
    {
      "id": "matin_01",
      "window": {"start": "08:00", "end": "10:00"},
      "animation_strategy": "random",
      "exclude_animations": ["animation_02"]
    },
    {
      "id": "matin_02",
      "window": {"start": "10:30", "end": "11:30"},
      "animation_strategy": "random",
      "exclude_animations": ["animation_02"]
    },
    {
      "id": "midi",
      "window": {"start": "12:00", "end": "14:30"},
      "animation_strategy": "random",
      "exclude_animations": ["animation_02"]
    },
    
    
    {
      "id": "soir_aleatoire",
      "window": {"start": "16:40", "end": "10:00"},
      "animation_strategy": "random",
      "exclude_animations": ["animation_02"]
    }
  ],
  "timezone": "Europe/Paris"
}
