    "history_summary_count": 15,
    "similar_cards_count": 3
  },

  "studio": {
    "loop_interval_minutes": 10,
    "window": { "start": "00:00", "end": "23:59" }
  },

  "sandbox": {
    "engine": "docker",
    "cpus": 3,
    "memory": "5g",
    "pids_limit": 256,
    "gpu": false,
    "build_timeout_seconds": 300,
