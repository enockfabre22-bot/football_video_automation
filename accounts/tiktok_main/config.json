{
  "platform": "tiktok",
  "enabled": true,
  "env_prefix": "TIKTOK_MAIN",
  "post_mode": "inbox",
  "privacy_level": "SELF_ONLY",
  "disable_comment": false,
  "disable_duet": false,
  "disable_stitch": false,
  "metadata_rules": {
    "hashtag_count": 3,
    "youtube_tag_count": 0
  },
  "schedule_slots": [
    {
      "id": "matin_01",
      "window": {"start": "08:00", "end": "10:00"},
      "animation_strategy": "random",
      "exclude_animations": ["animation_02"]
    },
    {
      "id": "matin_02",
      "window": {"start": "10:30", "end": "11:30"},
      "animation_strategy": "random",
      "exclude_animations": ["animation_02"]
    },
    {
      "id": "midi",
      "window": {"start": "12:30", "end": "14:30"},
      "animation_strategy": "random",
      "exclude_animations": ["animation_02"]
    },
    
    
    {
      "id": "soir_aleatoire",
      "window": {"start": "16:00", "end": "18:00"},
      "animation_strategy": "random",
      "exclude_animations": ["animation_02"]
    }
  ],
  "timezone": "Europe/Paris"
}
