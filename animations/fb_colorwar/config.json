{
  "name": "fb_colorwar",
  "enabled": true,
  "accounts": [
    "youtube_avantfoot",
    "tiktok_main"
  ],
  "requires_match_data": false,
  "inputs": [
    "football_pack"
  ],
  "football": {
    "format": "colorwar",
    "packs": [
      "premier_league",
      "laliga",
      "serie_a",
      "bundesliga",
      "ligue_1",
      "champions_league",
      "europe_giants",
      "big_six",
      "world_nations",
      "euro_nations",
      "africa_nations",
      "south_america"
    ],
    "team_counts": [
      4,
      6
    ],
    "popular_bias": 1.2,
    "repeat_days": 4,
    "prefer_full_pack": false
  },
  "min_free_disk_gb": 3,
  "metadata": {
    "titles": [
      "Color war: {competition} edition 🎨",
      "Which {competition} {single} conquers the map? 🗺️",
      "{count} {noun}, 1 map: who wins? 🎨",
      "{competition} color war 🎨 Who takes over?"
    ],
    "descriptions": [
      "{count} {competition} {noun} fight for every square of the map. Paint bombs, comebacks, a final countdown... who conquers the map? 👇\n\n🔔 Subscribe for a new football simulation every day!"
    ],
    "hashtags": [
      "#{competition_tag}",
      "#football",
      "#soccer",
      "#colorwar",
      "#satisfying",
      "#footballshorts",
      "#fyp"
    ],
    "youtube_tags": [
      "{competition}",
      "color war",
      "territory war",
      "{competition} simulation",
      "pong wars",
      "football",
      "soccer",
      "football simulation",
      "simulation",
      "football shorts",
      "satisfying",
      "ball battle",
      "who will win",
      "football prediction",
      "marble race",
      "physics simulation"
    ]
  },
  "thumbnail": {
    "enabled": false
  },
  "steps": [
    {
      "type": "python",
      "name": "Préparation (colorwar : équipes, écussons, fond, textes)",
      "script": "engines/football/prepare.py",
      "args": [
        "--format",
        "colorwar"
      ]
    },
    {
      "type": "sandbox",
      "name": "Rendu raylib (moteur foot)",
      "profile": "raylib_box2d",
      "source": "../../engines/football/scene",
      "sounds_dir": "../../assets/sounds/football",
      "seed": "random",
      "video_from": "football/video.json"
    },
    {
      "type": "python",
      "name": "Ambiance de stade, mixage -14 LUFS, miniature",
      "script": "engines/football/finalize.py"
    }
  ]
}
